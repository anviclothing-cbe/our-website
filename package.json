{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "lib/api-client-react",
    "lib/api-spec",
    "lib/api-zod",
    "lib/db",
    "scripts"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "start": "node server.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
